# Copy to apps/web/.env.local and fill in. Placeholders only: never commit real values.
# Missing values => demo mode (deterministic AI provider; synthetic fixtures once built).

# Supabase. NEXT_PUBLIC_* values reach the browser; safe only because every table has RLS.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe key. New projects call it the publishable key; older ones the anon key.
# Either name works; the publishable name wins when both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Never import in client components.
# New projects call it the secret key; older ones the service-role key.
# Either name works; the secret name wins when both are set.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta Model API (server only). Get a key from the dev.meta.ai dashboard.
# MODEL_API_KEY is the canonical name; META_MODEL_API_KEY still works as a fallback.
MODEL_API_KEY=
META_MODEL_API_KEY=
# Base URL and model (defaults work; override only if official docs direct it).
META_MODEL_API_URL=https://api.meta.ai/v1
META_MODEL_MODEL=muse-spark-1.3
# demo | meta. "meta" is used only when an API key is also set.
AI_PROVIDER=demo

# Transactional email (Resend, server only). Without these, the app sends
# in-app notifications only and says so. See docs/EMAIL_SETUP.md.
# Sender address must belong to a domain verified in Resend (DNS).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Tulay <hello@example.com>
# Svix signing secret for delivery webhooks (documented; handler deferred).
RESEND_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
